{
  "name": "registry-to-list-local",
  "private": true,
  "version": "1.0.0",
  "description": "離線優先的土地謄本轉清冊工具",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "pdfjs-dist": "^5.4.624",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "tw.gov.registrytolist",
    "productName": "謄本轉清冊",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "vendor/**",
      "ocr-assets/**",
      "land-sections.json",
      "localities.json",
      "roads.json",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "artifactName": "${productName}-桌面版-${version}.${ext}"
  },
  "main": "electron-main.cjs"
}
